# Copie para .env e escolha uma senha local (nao envie o .env ao Git).
# Use somente letras, numeros, hifen e underscore para evitar escape na URL AMQP.
APP_PORT=8080
RABBITMQ_USER=battlesim
RABBITMQ_PASSWORD=troque_por_uma_senha_local
# Trabalho real de CPU por batalha, de 0 a 20000000.
# Para demonstrar distribuicao/CPU: 500000 ou 1000000.
WORKER_CPU_ITERATIONS=0
# Slots simultaneos por worker, inteiro de 1 a 20 (padrao: 1).
# O perfil Kubernetes de 100 batalhas usa 5 workers x 20; veja docs/concurrent100.md.
WORKER_CONCURRENCY=1
